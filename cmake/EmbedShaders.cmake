# pb_embed_shaders(<target> <out_header> <files...>)
# Generates a header with one `inline constexpr const char* kShader_<name>_<ext>`
# per GLSL file, so shaders ship inside the binary.
function(pb_embed_shaders target out_header)
  set(script "${CMAKE_CURRENT_BINARY_DIR}/embed_shaders_${target}.cmake")
  file(WRITE "${script}" [=[
file(WRITE "${OUT}" "#pragma once\n// Generated by EmbedShaders.cmake - do not edit.\n")
foreach(f IN LISTS FILES)
  get_filename_component(name "${f}" NAME_WE)
  get_filename_component(ext "${f}" EXT)
  string(SUBSTRING "${ext}" 1 -1 ext)
  file(READ "${f}" body)
  file(APPEND "${OUT}" "inline constexpr const char* kShader_${name}_${ext} = R\"glsl(${body})glsl\";\n")
endforeach()
]=])
  add_custom_command(
    OUTPUT "${out_header}"
    COMMAND ${CMAKE_COMMAND} "-DOUT=${out_header}" "-DFILES=${ARGN}" -P "${script}"
    DEPENDS ${ARGN} "${script}"
    COMMENT "Embedding shaders into ${out_header}"
    VERBATIM)
  target_sources(${target} PRIVATE "${out_header}")
  get_filename_component(dir "${out_header}" DIRECTORY)
  target_include_directories(${target} PRIVATE "${dir}")
endfunction()
